# Copy this file to .env and fill it in. The real .env is git-ignored.

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
# Replace <user> and <password>, and keep the database name (business-directory).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/business-directory?retryWrites=true&w=majority

# Port for local development (Render sets its own PORT automatically).
PORT=5000

# Optional: only allow these websites to call the API (comma-separated).
# Leave it out while developing. Add your Netlify URL once the site is live.
# CORS_ORIGIN=https://your-site.netlify.app

# Optional: if you get "querySrv ECONNREFUSED" when connecting to Atlas (a DNS problem on some
# networks), uncomment this to use Google and Cloudflare DNS for the lookup.
# DNS_SERVERS=8.8.8.8,1.1.1.1
